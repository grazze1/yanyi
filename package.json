{
  "name": "yanyi",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/grazze1/yanyi.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:chrome": "pnpm --filter @yanyi/edge-extension build:chrome",
    "dev:extension": "pnpm --filter @yanyi/edge-extension dev",
    "dev:desktop": "pnpm --filter @yanyi/desktop tauri dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:native-host": "node scripts/test-native-host-handshake.mjs",
    "test:native-host:translation": "node scripts/test-native-host-translation.mjs",
    "test:native-host:errors": "node scripts/test-native-host-errors.mjs",
    "test:native-host:real-translation": "node scripts/test-native-host-real-translation.mjs",
    "test:native-host:real-assistant": "node scripts/test-native-host-real-assistant.mjs",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @yanyi/edge-extension build:test && pnpm --filter @yanyi/edge-extension build:test:chrome && playwright test",
    "test:e2e:production": "pnpm --filter @yanyi/edge-extension build && set YANYI_E2E_PRODUCTION=1&& playwright test -g production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean-workspace.mjs all",
    "clean:artifacts": "node scripts/clean-workspace.mjs artifacts",
    "clean:test-data": "node scripts/clean-workspace.mjs test-data",
    "test:release-contents": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-ReleaseContents.ps1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
